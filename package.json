{
  "name": "japp",
  "version": "1.0.0",
  "description": "A modern Markdown editor with Git integration",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:main": "tsc --project tsconfig.main.json --noEmit",
    "type-check:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "type-check:preload": "tsc --project tsconfig.preload.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saydullayev017/Japp.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "git"
  ],
  "author": "Your Name",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Saydullayev017/Japp/issues"
  },
  "homepage": "https://github.com/Saydullayev017/Japp#readme",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "electron": "^40.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
